<Application x:Class="VeyonSync.StudentApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="clr-namespace:VeyonSync.Desktop;assembly=VeyonSync.Desktop"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/VeyonSync.Desktop;component/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <d:StateGlyphConverter x:Key="Glyph"/>
            <d:LocalTimeConverter x:Key="Time"/>
            <d:EmptyDashConverter x:Key="Dash"/>
            <d:BoolVisibilityConverter x:Key="Vis"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
