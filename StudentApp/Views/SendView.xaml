<UserControl x:Class="VeyonSync.StudentApp.Views.SendView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Uma etapa do envio: círculo com ícone + título + legenda -->
        <DataTemplate x:Key="StepTemplate">
            <StackPanel HorizontalAlignment="Center">
                <Grid Width="40" Height="40" HorizontalAlignment="Center">
                    <Ellipse Fill="{DynamicResource Surface}"/>
                    <Ellipse Fill="{Binding Kind, Converter={StaticResource KindSoft}}" Stroke="{Binding Kind, Converter={StaticResource KindBrush}}" StrokeThickness="2"/>
                    <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" HorizontalAlignment="Center" Foreground="{Binding Kind, Converter={StaticResource KindBrush}}"/>
                </Grid>
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,8,0,0"/>
                <TextBlock Style="{StaticResource Caption}" Text="{Binding Caption}" HorizontalAlignment="Center" TextAlignment="Center"/>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,14,16,24">
            <TextBlock Style="{StaticResource H1}" Text="Atualizar e enviar"/>
            <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,16" Text="Coleta os dados atuais deste computador e envia ao professor do laboratório. A confirmação só aparece depois que o professor responde."/>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <!-- Etapas reais -->
                    <Grid Margin="0,4,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Linha que liga as etapas (do centro da 1ª ao centro da 3ª) -->
                        <Border Grid.Column="1" Grid.ColumnSpan="4" Height="2" VerticalAlignment="Top" Margin="0,19,0,0" Background="{DynamicResource BorderBrush}"/>
                        <ContentControl Grid.ColumnSpan="2" Content="{Binding Step1}" ContentTemplate="{StaticResource StepTemplate}" Focusable="False" AutomationProperties.Name="Etapa 1: coleta local"/>
                        <ContentControl Grid.Column="2" Grid.ColumnSpan="2" Content="{Binding Step2}" ContentTemplate="{StaticResource StepTemplate}" Focusable="False" AutomationProperties.Name="Etapa 2: envio"/>
                        <ContentControl Grid.Column="4" Grid.ColumnSpan="2" Content="{Binding Step3}" ContentTemplate="{StaticResource StepTemplate}" Focusable="False" AutomationProperties.Name="Etapa 3: confirmação do professor"/>
                    </Grid>

                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding SendCmd}" HorizontalAlignment="Stretch" Padding="18,12" FontSize="16">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE898;" Margin="0,0,10,0" FontSize="18"/><TextBlock Text="Coletar e enviar agora"/></StackPanel>
                    </Button>
                    <ProgressBar IsIndeterminate="True" Margin="0,4,0,8" Visibility="{Binding Sending, Converter={StaticResource Vis}}"/>
                    <Border CornerRadius="8" Padding="14,10" Margin="0,4,0,0" BorderThickness="1"
                            Background="{Binding SendKind, Converter={StaticResource KindSoft}}" BorderBrush="{Binding SendKind, Converter={StaticResource KindBrush}}"
                            Visibility="{Binding SendResult, Converter={StaticResource TextVis}}">
                        <DockPanel>
                            <TextBlock Style="{StaticResource Icon}" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Top"
                                       Text="{Binding SendKind, Converter={StaticResource KindGlyph}}" Foreground="{Binding SendKind, Converter={StaticResource KindBrush}}"/>
                            <StackPanel>
                                <TextBlock Text="{Binding SendResult}"/>
                                <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="0,6,0,0" Content="Tentar novamente" Command="{Binding SendCmd}"
                                        Visibility="{Binding SendFailed, Converter={StaticResource Vis}}"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0" Visibility="{Binding NeedsPairing, Converter={StaticResource Vis}}"
                               Text="Disponível depois do credenciamento."/>
                </StackPanel>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1.4*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}" Text="Situação atual"/>
                        <TextBlock Text="{Binding LastConfirmedText}" Margin="0,0,0,8"/>
                        <TextBlock><Run Text="Envio: "/><Run FontWeight="SemiBold" Text="{Binding Status.SendStatus, Mode=OneWay}"/></TextBlock>
                        <TextBlock Style="{StaticResource Caption}" Text="{Binding Status.LastError}" Visibility="{Binding Status.LastError, Converter={StaticResource TextVis}}" Margin="0,4,0,0"/>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" Visibility="{Binding Status.PendingReport, Converter={StaticResource Vis}}"
                                   Text="Há dados guardados aguardando envio; serão enviados na próxima tentativa."/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}" Text="Tentativas recentes"/>
                        <TextBlock Style="{StaticResource Caption}" Text="Nenhuma tentativa registrada ainda." Visibility="{Binding Attempts.Count, Converter={StaticResource CountVis}, ConverterParameter=invert}"/>
                        <ItemsControl ItemsSource="{Binding Attempts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}" Text="{Binding Ts, Converter={StaticResource Time}}" Margin="8,0,0,0" TextWrapping="NoWrap"/>
                                        <TextBlock FontSize="13" Margin="0,2,10,0" VerticalAlignment="Top">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                                    <Setter Property="Text" Value="&#xE783;"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource Err}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Ok}" Value="True">
                                                            <Setter Property="Text" Value="&#xE73E;"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource Ok}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <StackPanel>
                                            <TextBlock><Run Text="Motivo: "/><Run Text="{Binding Reason, Mode=OneWay}"/></TextBlock>
                                            <TextBlock Style="{StaticResource Caption}" Text="{Binding Message}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
