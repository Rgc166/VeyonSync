<UserControl x:Class="VeyonSync.StudentApp.Views.ErrorsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="28,14,16,16">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <Border DockPanel.Dock="Right" Style="{StaticResource Pill}" Padding="12,6" VerticalAlignment="Top" Margin="0,0,12,0"
                    Background="{Binding ErrorsKind, Converter={StaticResource KindSoft}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0" Text="{Binding ErrorsKind, Converter={StaticResource KindGlyph}}" Foreground="{Binding ErrorsKind, Converter={StaticResource KindBrush}}"/>
                    <TextBlock Text="{Binding ErrorsCardText}" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
            <StackPanel Margin="0,0,16,0">
                <TextBlock Style="{StaticResource H1}" Text="Erros"/>
                <TextBlock Style="{StaticResource Muted}" Text="Erros da coleta e do envio deste computador (sem senhas, códigos ou credenciais). Um envio confirmado resolve os erros de comunicação."/>
            </StackPanel>
        </DockPanel>

        <WrapPanel DockPanel.Dock="Top">
            <Border Style="{StaticResource SegmentHost}">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource Segment}" GroupName="StdErrMode" IsChecked="{Binding ShowActive}" Content="Ativos"/>
                    <RadioButton Style="{StaticResource Segment}" GroupName="StdErrMode" IsChecked="{Binding ShowResolved}" Content="Resolvidos"/>
                </StackPanel>
            </Border>
            <Button Style="{StaticResource GhostButton}" Command="{Binding ExportErrorsCmd}" ToolTip="TXT, PDF ou DOCX (não precisa do Word)">
                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="13" Margin="0,0,6,0"/><TextBlock Text="Exportar"/></StackPanel>
            </Button>
            <Button Style="{StaticResource GhostButton}" Command="{Binding ClearErrorsCmd}" Visibility="{Binding ShowActive, Converter={StaticResource Vis}}">
                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="13" Margin="0,0,6,0"/><TextBlock Text="Marcar todos como resolvidos"/></StackPanel>
            </Button>
        </WrapPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="240"/>
                <ColumnDefinition Width="1.3*"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="8">
                <Grid>
                    <TextBlock Style="{StaticResource Muted}" Margin="10" Text="Nada por aqui. Nenhum erro nesta lista."
                               Visibility="{Binding ErrorList.Count, Converter={StaticResource CountVis}, ConverterParameter=invert}"/>
                    <ListBox Style="{StaticResource PlainList}" ItemContainerStyle="{StaticResource PlainItem}" ItemsSource="{Binding ErrorList}" SelectedItem="{Binding SelectedError}"
                             AutomationProperties.Name="Lista de erros">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}" Text="{Binding Ts, Converter={StaticResource Time}}" Margin="8,0,0,0" TextWrapping="NoWrap"/>
                                    <TextBlock FontSize="14" Margin="0,2,10,0" VerticalAlignment="Top">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                                <Setter Property="Text" Value="&#xE7BA;"/>
                                                <Setter Property="Foreground" Value="{DynamicResource Err}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Resolved}" Value="True">
                                                        <Setter Property="Text" Value="&#xE73E;"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource Ok}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Message}" MaxHeight="40" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Card}">
                <Grid>
                    <TextBlock Style="{StaticResource Muted}" Text="Selecione um erro para ver os detalhes." Visibility="{Binding HasSelectedError, Converter={StaticResource Vis}, ConverterParameter=invert}"/>
                    <DockPanel Visibility="{Binding HasSelectedError, Converter={StaticResource Vis}}">
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Style="{StaticResource Label}" Text="DETALHES DO ERRO"/>
                            <TextBlock Style="{StaticResource Label}" Text="Data e hora" Margin="0,8,0,2"/>
                            <TextBlock Text="{Binding SelectedError.Ts, Converter={StaticResource Time}}" Margin="0,0,0,10"/>
                            <TextBlock Style="{StaticResource Label}" Text="Situação"/>
                            <TextBlock Margin="0,0,0,10">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Ativo"/>
                                        <Setter Property="Foreground" Value="{DynamicResource Err}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedError.Resolved}" Value="True">
                                                <Setter Property="Text" Value="Resolvido"/>
                                                <Setter Property="Foreground" Value="{DynamicResource Ok}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Style="{StaticResource Label}" Text="Descrição"/>
                        </StackPanel>
                        <WrapPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                            <Button Command="{Binding CopyErrorCmd}">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;" FontSize="13" Margin="0,0,6,0"/><TextBlock Text="Copiar detalhes"/></StackPanel>
                            </Button>
                            <Button Style="{StaticResource PrimaryButton}" Command="{Binding SendCmd}" Visibility="{Binding ShowActive, Converter={StaticResource Vis}}"
                                    ToolTip="Faz uma nova coleta e envio ao professor">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="13" Margin="0,0,6,0"/><TextBlock Text="Tentar enviar novamente"/></StackPanel>
                            </Button>
                        </WrapPanel>
                        <Border Style="{StaticResource Inset}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBox Style="{StaticResource ReadOnlyValue}" FontFamily="Consolas" FontSize="12.5" Text="{Binding SelectedError.Message, Mode=OneWay}"/>
                            </ScrollViewer>
                        </Border>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
