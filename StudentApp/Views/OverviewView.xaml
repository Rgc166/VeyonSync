<UserControl x:Class="VeyonSync.StudentApp.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="Row" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,14,16,24">
            <!-- Primeiro acesso -->
            <Border Style="{StaticResource Card}" Background="{DynamicResource WarnSoft}" BorderBrush="{DynamicResource Warn}" Visibility="{Binding NeedsPairing, Converter={StaticResource Vis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Credenciar este computador" Command="{Binding GoCmd}" CommandParameter="5" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" Foreground="{DynamicResource Warn}" Margin="0,0,10,0" VerticalAlignment="Top"/>
                    <TextBlock Text="Este computador ainda não está credenciado. Importe o arquivo de ligação do laboratório e informe o número do PC e o código do professor." VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <!-- Número do PC em destaque -->
            <DockPanel Margin="0,0,0,18">
                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Command="{Binding SendCmd}" VerticalAlignment="Center" Padding="18,10">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE898;" Margin="0,0,8,0"/><TextBlock Text="Atualizar e enviar"/></StackPanel>
                </Button>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Style="{StaticResource Label}" Text="ESTE COMPUTADOR"/>
                    <TextBlock FontSize="36" FontWeight="SemiBold" Text="{Binding PositionText}" TextWrapping="NoWrap"/>
                    <TextBlock Style="{StaticResource Muted}"><Run Text="{Binding Status.LabName, Mode=OneWay}"/><Run Text=" · hostname "/><Run Text="{Binding Status.WindowsName, Mode=OneWay}"/></TextBlock>
                </StackPanel>
            </DockPanel>

            <!-- Três cartões -->
            <UniformGrid Columns="3">
                <Button Style="{StaticResource StatButton}" Command="{Binding GoCmd}" CommandParameter="2" AutomationProperties.Name="Erros">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Icon}" Text="{Binding ErrorsKind, Converter={StaticResource KindGlyph}}" Foreground="{Binding ErrorsKind, Converter={StaticResource KindBrush}}"/>
                            <TextBlock Style="{StaticResource Label}" Text="Erros"/>
                        </DockPanel>
                        <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding ErrorsCardText}" Margin="0,4,0,2"/>
                        <TextBlock Style="{StaticResource Caption}" Text="Ver registros"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource StatButton}" Command="{Binding GoCmd}" CommandParameter="1" AutomationProperties.Name="Envio">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Icon}" Text="{Binding SendCardKind, Converter={StaticResource KindGlyph}}" Foreground="{Binding SendCardKind, Converter={StaticResource KindBrush}}"/>
                            <TextBlock Style="{StaticResource Label}" Text="Envio"/>
                        </DockPanel>
                        <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding SendCardTitle}" Margin="0,4,0,2"/>
                        <TextBlock Style="{StaticResource Caption}" Text="Recebimento confirmado pelo professor"/>
                    </StackPanel>
                </Button>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Icon}" Text="{Binding VeyonServiceKind, Converter={StaticResource KindGlyph}}" Foreground="{Binding VeyonServiceKind, Converter={StaticResource KindBrush}}"/>
                            <TextBlock Style="{StaticResource Label}" Text="Veyon"/>
                        </DockPanel>
                        <TextBlock FontSize="17" FontWeight="SemiBold" Margin="0,4,0,2"><Run Text="Serviço local: "/><Run Text="{Binding Status.VeyonService, Mode=OneWay}"/></TextBlock>
                        <TextBlock Style="{StaticResource Caption}" Text="Conectividade com o Veyon Master: não verificada por este computador."/>
                        <TextBlock Style="{StaticResource Caption}"><Run Text="Integração no professor: "/><Run Text="{Binding Status.VeyonState, Mode=OneWay}"/></TextBlock>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.4*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!-- Ficha do computador -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding CopyAllCmd}" Margin="0">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;" FontSize="13" Margin="0,0,6,0"/><TextBlock Text="Copiar todos"/></StackPanel>
                            </Button>
                            <TextBlock Style="{StaticResource H2}" Text="Informações deste computador" Margin="0"/>
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Command="{Binding CopyCmd}" CommandParameter="{Binding Status.User}" ToolTip="Copiar usuário"><TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;" FontSize="12"/></Button>
                            <TextBlock Style="{StaticResource Label}" Width="110" Text="Usuário" VerticalAlignment="Center" Margin="0"/>
                            <StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Status.User, Converter={StaticResource Dash}}"/><TextBlock Style="{StaticResource Caption}" Text="{Binding Status.UserNote}" Visibility="{Binding Status.UserNote, Converter={StaticResource TextVis}}"/></StackPanel>
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Command="{Binding CopyCmd}" CommandParameter="{Binding Status.Ip}" ToolTip="Copiar IP"><TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;" FontSize="12"/></Button>
                            <TextBlock Style="{StaticResource Label}" Width="110" Text="IP" VerticalAlignment="Center" Margin="0"/>
                            <TextBlock VerticalAlignment="Center" Text="{Binding Status.Ip, Converter={StaticResource Dash}}"/>
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Command="{Binding CopyCmd}" CommandParameter="{Binding Status.Mac}" ToolTip="Copiar MAC"><TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;" FontSize="12"/></Button>
                            <TextBlock Style="{StaticResource Label}" Width="110" Text="MAC" VerticalAlignment="Center" Margin="0"/>
                            <TextBlock VerticalAlignment="Center" Text="{Binding Status.Mac, Converter={StaticResource Dash}}"/>
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Command="{Binding CopyCmd}" CommandParameter="{Binding TeacherText}" ToolTip="Copiar professor"><TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;" FontSize="12"/></Button>
                            <TextBlock Style="{StaticResource Label}" Width="110" Text="Professor" VerticalAlignment="Center" Margin="0"/>
                            <TextBlock VerticalAlignment="Center" Text="{Binding TeacherText, Converter={StaticResource Dash}}"/>
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}" Margin="0">
                            <TextBlock Style="{StaticResource Label}" Width="110" Text="Status" VerticalAlignment="Top" Margin="0"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Top" Text="{Binding Status.SendStatus, Converter={StaticResource Glyph}}" Foreground="{Binding Status.SendStatus, Converter={StaticResource Glyph}, ConverterParameter=brush}"/>
                                <TextBlock Text="{Binding StatusLine}" MaxWidth="420"/>
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>
                <!-- Modo de envio -->
                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}" Text="Modo de envio"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Style="{StaticResource Pill}" Background="{DynamicResource WarnSoft}" Margin="0,0,8,0" Visibility="{Binding Status.AutoSend, Converter={StaticResource Vis}, ConverterParameter=invert}">
                                <TextBlock Text="M · Manual" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource Warn}"/>
                            </Border>
                            <Border Style="{StaticResource Pill}" Background="{DynamicResource OkSoft}" Visibility="{Binding Status.AutoSend, Converter={StaticResource Vis}}">
                                <TextBlock Text="Automático" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource Ok}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding ModeSummary}"/>
                        <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="0,10,0,0" Content="Alterar nas configurações" Command="{Binding GoCmd}" CommandParameter="4"/>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" Text="{Binding UpdateStatusText}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
