<Window x:Class="VeyonSync.TeacherApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Veyon Sync THC — Professor" Width="1240" Height="780" MinWidth="820" MinHeight="500"
        WindowStartupLocation="CenterScreen" Style="{StaticResource AppWindow}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Barra lateral recolhível -->
        <Border x:Name="Side" Width="236" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="14,16,10,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="38" Height="38" CornerRadius="10" Background="{DynamicResource PrimarySoft}" BorderBrush="{DynamicResource Primary}" BorderThickness="1">
                        <Image x:Name="Logo" Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <TextBlock x:Name="LogoGlyph" Style="{StaticResource Icon}" Text="&#xE7F4;" FontSize="18" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" Width="38" TextAlignment="Center"/>
                    <StackPanel x:Name="Brand" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Veyon Sync" FontSize="16" FontWeight="SemiBold" TextWrapping="NoWrap"/>
                        <TextBlock Text="THC · Professor" FontSize="12" Foreground="{DynamicResource Accent}" TextWrapping="NoWrap"/>
                    </StackPanel>
                </Grid>
                <StackPanel DockPanel.Dock="Bottom" Margin="8,8,8,12">
                    <Button x:Name="ToggleSide" Style="{StaticResource GhostButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="ToggleSidebar"
                            AutomationProperties.Name="Recolher ou expandir a barra lateral" ToolTip="Recolher / expandir">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ToggleGlyph" Style="{StaticResource Icon}" Text="&#xE76B;" FontSize="13" HorizontalAlignment="Center" Foreground="{DynamicResource TextMuted}"/>
                            <TextBlock x:Name="ToggleText" Grid.Column="1" Text="Recolher" Margin="12,0,0,0" Foreground="{DynamicResource TextMuted}" FontSize="12.5"/>
                        </Grid>
                    </Button>
                    <TextBlock x:Name="VersionLabel" Margin="12,6,0,0" Style="{StaticResource Caption}" Text="{Binding VersionText}" ToolTip="Versão instalada"/>
                </StackPanel>
                <ListBox x:Name="Nav" Style="{StaticResource NavList}" ItemContainerStyle="{StaticResource NavItem}" ItemTemplate="{StaticResource NavEntryTemplate}"
                         ItemsSource="{Binding NavEntries}" SelectionChanged="NavChanged" AutomationProperties.Name="Navegação"/>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Faixa superior: contexto e acesso administrativo -->
            <DockPanel Margin="28,12,20,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Border Style="{StaticResource Pill}" Margin="0,0,8,0" ToolTip="Laboratório atendido por este professor">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7F4;" FontSize="12" Foreground="{DynamicResource Accent}" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding LabText}" FontSize="12.5"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Pill}" Visibility="{Binding IsAdmin, Converter={StaticResource Vis}}" ToolTip="A interface está aberta com permissão de administrador do Windows">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7EF;" FontSize="12" Foreground="{DynamicResource Ok}" Margin="0,0,6,0"/>
                            <TextBlock Text="Administrador" FontSize="12.5"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <ProgressBar IsIndeterminate="True" Height="3" Width="120" HorizontalAlignment="Left" VerticalAlignment="Center"
                             Visibility="{Binding Busy, Converter={StaticResource Vis}}" ToolTip="Trabalhando..."/>
            </DockPanel>

            <!-- Avisos persistentes (serviço indisponível, erros) -->
            <StackPanel Grid.Row="1" Margin="28,10,20,0">
                <Border CornerRadius="8" Background="{DynamicResource ErrSoft}" BorderBrush="{DynamicResource Err}" BorderThickness="1" Padding="14,10" Margin="0,0,0,8"
                        Visibility="{Binding ServiceOk, Converter={StaticResource Vis}, ConverterParameter=invert}">
                    <DockPanel>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE783;" Foreground="{DynamicResource Err}" Margin="0,0,10,0" VerticalAlignment="Top"/>
                        <TextBlock Text="{Binding ServiceError}"/>
                    </DockPanel>
                </Border>
                <Border x:Name="ErrorBar" Visibility="Collapsed" CornerRadius="8" Background="{DynamicResource ErrSoft}" BorderBrush="{DynamicResource Err}" BorderThickness="1" Padding="14,8" Margin="0,0,0,8">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Fechar" Margin="8,0,0,0" Click="CloseError"/>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE783;" Foreground="{DynamicResource Err}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ErrorText" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>
            </StackPanel>

            <ContentControl x:Name="Host" Grid.Row="2" Focusable="False"/>

            <!-- Notificação curta de sucesso (some sozinha) -->
            <Border x:Name="Toast" Grid.Row="2" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,24" MaxWidth="520"
                    CornerRadius="10" Padding="14,10" Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <DockPanel>
                    <TextBlock x:Name="ToastIcon" Style="{StaticResource Icon}" Margin="0,0,10,0" VerticalAlignment="Top"/>
                    <TextBlock x:Name="ToastText"/>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
