<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>VeyonSync.Teacher.App</AssemblyName>
    <RootNamespace>VeyonSync.TeacherApp</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>Veyon Sync THC</Product>
    <AssemblyTitle>Veyon Sync THC — Professor</AssemblyTitle>
    <ApplicationIcon Condition="Exists('..\assets\icons\thc.ico')">..\assets\icons\thc.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Shared/Shared.csproj" />
    <ProjectReference Include="../Desktop/Desktop.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\assets\icons\thc.ico" Condition="Exists('..\assets\icons\thc.ico')" Link="icon.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
