<UserControl x:Class="VeyonSync.TeacherApp.Views.MapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="28,14,16,16">
        <!-- Cabeçalho -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <Border Style="{StaticResource SegmentHost}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="ViewMode" Style="{StaticResource Segment}" GroupName="MapMode" IsChecked="True" Checked="ModeChanged" AutomationProperties.Name="Modo visualizar">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE890;" FontSize="13" Margin="0,0,6,0"/><TextBlock Text="Visualizar"/></StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="EditMode" Style="{StaticResource Segment}" GroupName="MapMode" Checked="ModeChanged" AutomationProperties.Name="Modo editar disposição">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE70F;" FontSize="13" Margin="0,0,6,0"/><TextBlock Text="Editar disposição"/></StackPanel>
                        </RadioButton>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SegmentHost}">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource IconButton}" Click="ZoomOut" ToolTip="Diminuir zoom" AutomationProperties.Name="Diminuir zoom"><TextBlock Style="{StaticResource Icon}" Text="&#xE738;" FontSize="12"/></Button>
                        <TextBlock x:Name="ZoomText" Text="100%" Width="46" TextAlignment="Center" VerticalAlignment="Center" FontSize="12.5"/>
                        <Button Style="{StaticResource IconButton}" Click="ZoomIn" ToolTip="Aumentar zoom" AutomationProperties.Name="Aumentar zoom"><TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12"/></Button>
                        <Button Style="{StaticResource IconButton}" Click="ZoomFit" ToolTip="Ajustar à janela" AutomationProperties.Name="Ajustar à janela"><TextBlock Style="{StaticResource Icon}" Text="&#xE740;" FontSize="12"/></Button>
                    </StackPanel>
                </Border>
            </StackPanel>
            <StackPanel Margin="0,0,16,0">
                <TextBlock Style="{StaticResource H1}" Text="Mapa da sala"/>
                <TextBlock Style="{StaticResource Muted}" Text="Fileiras em colunas, computadores de cima para baixo. As posições acompanham a identidade do computador (mudar o IP não muda o lugar)."/>
            </StackPanel>
        </DockPanel>

        <!-- Busca e ferramentas de edição -->
        <WrapPanel DockPanel.Dock="Top">
            <Grid Width="240" Margin="0,0,8,8">
                <TextBox x:Name="SearchBox" Margin="0" Padding="34,7,10,7" TextChanged="SearchChanged" AutomationProperties.Name="Buscar no mapa"/>
                <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="13" Margin="12,0,0,0" HorizontalAlignment="Left" Foreground="{DynamicResource TextMuted}" IsHitTestVisible="False"/>
                <TextBlock Text="Destacar PC, IP ou usuário" Margin="36,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}" IsHitTestVisible="False" FontSize="13"
                           Visibility="{Binding Text, ElementName=SearchBox, Converter={StaticResource TextVis}, ConverterParameter=invert}"/>
            </Grid>
            <Button Style="{StaticResource GhostButton}" Click="Reload" Margin="0,0,8,8">
                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="13" Margin="0,0,6,0"/><TextBlock Text="Recarregar"/></StackPanel>
            </Button>
            <WrapPanel x:Name="EditBar" Visibility="Collapsed">
                <Button Click="AddRow"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE710;" Margin="0,0,8,0"/><TextBlock Text="Nova fileira"/></StackPanel></Button>
                <TextBox x:Name="CountsBox" Width="110" Text="5,6,6,6" ToolTip="Quantidade de posições por fileira, separadas por vírgula (ex.: 5,6,6,6)" AutomationProperties.Name="Posições por fileira"/>
                <Button Click="Generate" Content="Gerar fileiras"/>
                <Button Click="AutoPlace" Content="Posicionar pelo número do PC"/>
                <Button Click="Discard" Content="Cancelar alterações"/>
                <Button Click="Save" Style="{StaticResource PrimaryButton}"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE74E;" Margin="0,0,8,0"/><TextBlock Text="Salvar disposição"/></StackPanel></Button>
                <TextBlock x:Name="DirtyText" Foreground="{DynamicResource Warn}" VerticalAlignment="Center" Margin="4,0,0,8"/>
            </WrapPanel>
        </WrapPanel>

        <!-- Legenda: comunicação, integração e modo de envio são estados diferentes -->
        <WrapPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" Margin="0,0,16,4"><Ellipse Width="9" Height="9" Fill="{DynamicResource Ok}" Margin="0,0,6,0"/><TextBlock Style="{StaticResource Caption}" Text="Comunicação recente"/></StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,16,4"><Ellipse Width="9" Height="9" Fill="{DynamicResource TextMuted}" Margin="0,0,6,0"/><TextBlock Style="{StaticResource Caption}" Text="Sem comunicação recente"/></StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,16,4"><TextBlock Style="{StaticResource Icon}" FontSize="11" Text="&#xE73E;" Foreground="{DynamicResource Ok}" Margin="0,0,6,0"/><TextBlock Style="{StaticResource Caption}" Text="Integrado no Veyon"/></StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,16,4"><TextBlock Style="{StaticResource Icon}" FontSize="11" Text="&#xE895;" Foreground="{DynamicResource Warn}" Margin="0,0,6,0"/><TextBlock Style="{StaticResource Caption}" Text="Integração pendente"/></StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,16,4"><TextBlock Style="{StaticResource Icon}" FontSize="11" Text="&#xE783;" Foreground="{DynamicResource Err}" Margin="0,0,6,0"/><TextBlock Style="{StaticResource Caption}" Text="Conflito ou erro"/></StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,16,4"><Border Style="{StaticResource Pill}" Background="{DynamicResource WarnSoft}" Padding="5,0" Margin="0,0,6,0"><TextBlock Text="M" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Warn}"/></Border><TextBlock Style="{StaticResource Caption}" Text="Envio manual"/></StackPanel>
            <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,4" Text="· Mover computadores aqui não altera o layout do Veyon Master."/>
        </WrapPanel>

        <!-- Não posicionados (modo edição) -->
        <Border x:Name="UnplacedPanel" DockPanel.Dock="Left" Width="220" Style="{StaticResource Card}" Visibility="Collapsed" AllowDrop="True"
                Drop="DropOnUnplaced" DragOver="DragOverAny">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource H2}" Text="Não posicionados"/>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Caption}" Margin="0,0,0,8" Text="Arraste para uma posição. Solte aqui para tirar do mapa."/>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="UnplacedList"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Border Style="{StaticResource Card}" Padding="14" Margin="0">
            <ScrollViewer x:Name="MapScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Grid x:Name="ZoomHost" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Grid.LayoutTransform>
                        <ScaleTransform x:Name="Zoom" ScaleX="1" ScaleY="1"/>
                    </Grid.LayoutTransform>
                    <StackPanel>
                        <TextBlock x:Name="EmptyHint" Style="{StaticResource Muted}" Margin="0,8" Visibility="Collapsed"
                                   Text="Nenhuma fileira ainda. Escolha Editar disposição e use Gerar fileiras (ex.: 5,6,6,6) ou Nova fileira."/>
                        <StackPanel x:Name="RowsPanel" Orientation="Horizontal"/>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Border>
    </DockPanel>
</UserControl>
