<UserControl x:Class="VeyonSync.TeacherApp.Views.MachinesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="Field" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,12,12"/>
        </Style>
    </UserControl.Resources>
    <Grid Margin="28,14,16,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <DockPanel>
            <!-- Cabeçalho -->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Top" HorizontalAlignment="Right" MaxWidth="560">
                    <Button Click="Collect" ToolTip="Pede um envio imediato aos computadores selecionados">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8B5;" Margin="0,0,8,0"/><TextBlock Text="Solicitar coleta"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource PrimaryButton}" Click="IntegrateSelected">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE895;" Margin="0,0,8,0"/><TextBlock Text="Integrar selecionados"/></StackPanel>
                    </Button>
                    <Button Command="{Binding ApplyLocalCmd}" ToolTip="Todos os computadores elegíveis deste laboratório (pendentes, sem conflito)">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8A9;" Margin="0,0,8,0"/><TextBlock Text="Integrar elegíveis"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource GhostButton}" Command="{Binding ExportInventoryCmd}" ToolTip="Exportar inventário (CSV)">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE74E;" Margin="0,0,8,0"/><TextBlock Text="Inventário CSV"/></StackPanel>
                    </Button>
                </WrapPanel>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Style="{StaticResource H1}" Text="Computadores"/>
                    <TextBlock Style="{StaticResource Muted}"><Run Text="{Binding LabText, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding MachinesCountText, Mode=OneWay}"/></TextBlock>
                </StackPanel>
            </DockPanel>

            <!-- Busca e filtros -->
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                <Grid Width="280" Margin="0,0,8,8">
                    <TextBox x:Name="SearchBox" Margin="0" Padding="34,7,10,7" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                             AutomationProperties.Name="Buscar computador"/>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="13" Margin="12,0,0,0" HorizontalAlignment="Left" Foreground="{DynamicResource TextMuted}" IsHitTestVisible="False"/>
                    <TextBlock Text="Buscar nome, número, usuário, IP ou MAC" Margin="36,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}" IsHitTestVisible="False" FontSize="13"
                               Visibility="{Binding Text, ElementName=SearchBox, Converter={StaticResource TextVis}, ConverterParameter=invert}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                </Grid>
                <ComboBox Width="220" ItemsSource="{Binding AgentFilters}" SelectedItem="{Binding AgentFilter}" ToolTip="Comunicação, modo de envio e coleta" AutomationProperties.Name="Filtro de estado"/>
                <ComboBox Width="230" ItemsSource="{Binding VeyonFilters}" SelectedItem="{Binding VeyonFilter}" ToolTip="Estado da integração com o Veyon" AutomationProperties.Name="Filtro de integração"/>
            </WrapPanel>

            <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,12,0">
                <DataGrid x:Name="MachineGrid" ItemsSource="{Binding Machines}" SelectionChanged="GridSelection" Background="Transparent" CanUserSortColumns="True"
                          AutomationProperties.Name="Lista de computadores">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="44" CanUserSort="False">
                            <DataGridTemplateColumn.Header>
                                <CheckBox x:Name="AllCheck" Style="{StaticResource PlainCheck}" Margin="0" Click="ToggleAll" ToolTip="Selecionar todos" AutomationProperties.Name="Selecionar todos"/>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox Style="{StaticResource PlainCheck}" Margin="0" Focusable="False"
                                              IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}, Mode=TwoWay}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="PC" Width="170" SortMemberPath="Position">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,4">
                                        <TextBlock FontWeight="SemiBold" Text="{Binding Position, Converter={StaticResource Dash}}" TextWrapping="NoWrap"/>
                                        <TextBlock Style="{StaticResource Caption}" Text="{Binding DisplayName}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Usuário" Binding="{Binding User, Converter={StaticResource Dash}}" SortMemberPath="User" Width="140"/>
                        <DataGridTextColumn Header="IP" Binding="{Binding Ip, Converter={StaticResource Dash}}" SortMemberPath="Ip" Width="120"/>
                        <DataGridTemplateColumn Header="Última comunicação" Width="170" SortMemberPath="LastSeen">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="9" Height="9" Margin="0,0,8,0" ToolTip="{Binding AgentState}">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{DynamicResource TextMuted}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Recent}" Value="True"><Setter Property="Fill" Value="{DynamicResource Ok}"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="{Binding LastSeen, Converter={StaticResource Time}}" TextWrapping="NoWrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Integração" Width="200" SortMemberPath="VeyonState">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" FontSize="13" Margin="0,0,6,0" Text="{Binding VeyonState, Converter={StaticResource Glyph}}" Foreground="{Binding VeyonState, Converter={StaticResource Glyph}, ConverterParameter=brush}"/>
                                        <TextBlock Text="{Binding VeyonState}" TextWrapping="NoWrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Coleta" Width="170" SortMemberPath="CollectStatus">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Visibility="{Binding CollectStatus, Converter={StaticResource TextVis}}">
                                        <TextBlock Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0" Text="{Binding CollectStatus, Converter={StaticResource Glyph}}" Foreground="{Binding CollectStatus, Converter={StaticResource Glyph}, ConverterParameter=brush}"/>
                                        <TextBlock Text="{Binding CollectStatus}" TextWrapping="NoWrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Envio" Width="90" SortMemberPath="AutoMode">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Style="{StaticResource Pill}" Background="{DynamicResource WarnSoft}" Padding="6,0" Margin="0,0,6,0"
                                                Visibility="{Binding AutoMode, Converter={StaticResource Vis}, ConverterParameter=invert}" ToolTip="Envio manual: os dados só chegam quando alguém envia no computador">
                                            <TextBlock Text="M" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource Warn}"/>
                                        </Border>
                                        <TextBlock TextWrapping="NoWrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Automático"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding AutoMode}" Value="False"><Setter Property="Text" Value="Manual"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Erros" Width="70" SortMemberPath="OpenErrors">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Visibility="{Binding OpenErrors, Converter={StaticResource CountVis}}">
                                        <TextBlock Style="{StaticResource Icon}" FontSize="12" Text="&#xE783;" Foreground="{DynamicResource Err}" Margin="0,0,5,0"/>
                                        <TextBlock Text="{Binding OpenErrors}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </DockPanel>

        <!-- Painel lateral do computador -->
        <Border Grid.Column="1" x:Name="Panel" Width="340" Style="{StaticResource Card}" Margin="4,0,0,0" Padding="0"
                Visibility="{Binding HasSelectedMachine, Converter={StaticResource Vis}}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="18,16,10,8">
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Command="{Binding CloseMachineCmd}" ToolTip="Fechar painel" AutomationProperties.Name="Fechar painel">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="12"/>
                    </Button>
                    <StackPanel>
                        <TextBlock Style="{StaticResource H1}" FontSize="22" Text="{Binding SelectedTitle}"/>
                        <TextBlock Style="{StaticResource Caption}" Text="{Binding SelectedMachine.DisplayName}"/>
                    </StackPanel>
                </DockPanel>
                <WrapPanel DockPanel.Dock="Bottom" Margin="18,8,10,10">
                    <Button Command="{Binding MachineCollectCmd}" Padding="10,6">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8B5;" FontSize="13" Margin="0,0,6,0"/><TextBlock Text="Coletar"/></StackPanel>
                    </Button>
                    <Button Command="{Binding MachineIntegrateCmd}" Padding="10,6" Style="{StaticResource PrimaryButton}">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE895;" FontSize="13" Margin="0,0,6,0"/><TextBlock Text="Integrar"/></StackPanel>
                    </Button>
                    <Button Command="{Binding MachineRenameCmd}" Padding="10,6">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE70F;" FontSize="13" Margin="0,0,6,0"/><TextBlock Text="Nome exibido"/></StackPanel>
                    </Button>
                    <Button Command="{Binding MachineHistoryCmd}" Padding="10,6">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE81C;" FontSize="13" Margin="0,0,6,0"/><TextBlock Text="Histórico"/></StackPanel>
                    </Button>
                    <Button Command="{Binding MachineRemoveCmd}" Padding="10,6" Style="{StaticResource DangerButton}">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="13" Margin="0,0,6,0"/><TextBlock Text="Remover"/></StackPanel>
                    </Button>
                </WrapPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18,0,12,8">
                        <Border Style="{StaticResource Inset}" Background="{DynamicResource ErrSoft}" BorderBrush="{DynamicResource Err}" Margin="0,0,0,12"
                                Visibility="{Binding SelectedMachine.Duplicate, Converter={StaticResource Vis}}">
                            <TextBlock Text="Possível identidade duplicada (imagem clonada). Reinstale o STD neste computador e credencie de novo."/>
                        </Border>
                        <UniformGrid Columns="2">
                            <StackPanel Style="{StaticResource Field}"><TextBlock Style="{StaticResource Label}" Text="Hostname (Windows)"/><TextBox Style="{StaticResource ReadOnlyValue}" Text="{Binding SelectedMachine.WindowsName, Mode=OneWay}"/></StackPanel>
                            <StackPanel Style="{StaticResource Field}"><TextBlock Style="{StaticResource Label}" Text="Laboratório"/><TextBox Style="{StaticResource ReadOnlyValue}" Text="{Binding SelectedMachine.Lab, Mode=OneWay}"/></StackPanel>
                            <StackPanel Style="{StaticResource Field}"><TextBlock Style="{StaticResource Label}" Text="Usuário"/><TextBox Style="{StaticResource ReadOnlyValue}" Text="{Binding SelectedMachine.User, Mode=OneWay, Converter={StaticResource Dash}}"/></StackPanel>
                            <StackPanel Style="{StaticResource Field}"><TextBlock Style="{StaticResource Label}" Text="IP"/><TextBox Style="{StaticResource ReadOnlyValue}" Text="{Binding SelectedMachine.Ip, Mode=OneWay, Converter={StaticResource Dash}}"/></StackPanel>
                            <StackPanel Style="{StaticResource Field}"><TextBlock Style="{StaticResource Label}" Text="MAC"/><TextBox Style="{StaticResource ReadOnlyValue}" Text="{Binding SelectedMachine.Mac, Mode=OneWay, Converter={StaticResource Dash}}"/></StackPanel>
                            <StackPanel Style="{StaticResource Field}"><TextBlock Style="{StaticResource Label}" Text="Versão do agente"/><TextBox Style="{StaticResource ReadOnlyValue}" Text="{Binding SelectedMachine.Version, Mode=OneWay, Converter={StaticResource Dash}}"/></StackPanel>
                        </UniformGrid>
                        <StackPanel Style="{StaticResource Field}"><TextBlock Style="{StaticResource Label}" Text="Última comunicação"/><TextBlock Text="{Binding SelectedMachine.LastSeen, Converter={StaticResource Time}}"/><TextBlock Style="{StaticResource Caption}" Text="{Binding SelectedMachine.AgentState}"/></StackPanel>
                        <StackPanel Style="{StaticResource Field}">
                            <TextBlock Style="{StaticResource Label}" Text="Modo de envio"/>
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Automático"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedMachine.AutoMode}" Value="False"><Setter Property="Text" Value="Manual (M): os dados chegam quando alguém envia no computador"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Field}">
                            <TextBlock Style="{StaticResource Label}" Text="Integração com o Veyon"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" FontSize="13" Margin="0,0,6,0" Text="{Binding SelectedMachine.VeyonState, Converter={StaticResource Glyph}}" Foreground="{Binding SelectedMachine.VeyonState, Converter={StaticResource Glyph}, ConverterParameter=brush}"/>
                                <TextBlock Text="{Binding SelectedMachine.VeyonState}"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Caption}" Text="Integrado no Veyon não garante que o computador esteja acessível agora."/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Field}" Visibility="{Binding SelectedMachine.CollectStatus, Converter={StaticResource TextVis}}">
                            <TextBlock Style="{StaticResource Label}" Text="Última coleta solicitada"/>
                            <TextBlock Text="{Binding SelectedMachine.CollectStatus}"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource H3}" Text="Erros ativos deste computador" Margin="0,4,0,6"/>
                        <TextBlock Style="{StaticResource Caption}" Text="Nenhum erro ativo." Visibility="{Binding MachineErrors.Count, Converter={StaticResource CountVis}, ConverterParameter=invert}"/>
                        <ItemsControl ItemsSource="{Binding MachineErrors}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Inset}" Margin="0,0,0,6">
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold"><Run Text="{Binding Source, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Count, Mode=OneWay}"/><Run Text="x"/></TextBlock>
                                            <TextBlock Style="{StaticResource Caption}" Text="{Binding Message}"/>
                                            <TextBlock Style="{StaticResource Caption}" Text="{Binding LastTs, Converter={StaticResource Time}}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource Label}" Text="Identificação técnica do agente" Margin="0,10,0,2"/>
                        <TextBox Style="{StaticResource ReadOnlyValue}" FontSize="11.5" Foreground="{DynamicResource TextMuted}" Text="{Binding SelectedMachine.AgentId, Mode=OneWay}"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
