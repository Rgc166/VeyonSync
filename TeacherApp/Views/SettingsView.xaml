<UserControl x:Class="VeyonSync.TeacherApp.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="SettingCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Width" Value="430"/>
        </Style>
        <Style x:Key="CardTitle" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
    </UserControl.Resources>
    <DockPanel Margin="28,14,16,16">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Style="{StaticResource H1}" Text="Configurações"/>
            <TextBlock Style="{StaticResource Muted}" Text="Personalize o funcionamento do Veyon Sync neste laboratório."/>
        </StackPanel>

        <!-- Barra de salvar: indica alterações não salvas -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Padding="14,10" Margin="0,8,12,0">
            <DockPanel>
                <WrapPanel DockPanel.Dock="Right">
                    <Button Style="{StaticResource GhostButton}" Command="{Binding DiagnosticsCmd}" Content="Salvar diagnóstico (TXT)" Margin="0,0,8,0"/>
                    <Button Command="{Binding DiscardSettingsCmd}" Content="Descartar" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding SaveSettingsCmd}" Margin="0">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE74E;" Margin="0,0,8,0"/><TextBlock Text="Salvar alterações"/></StackPanel>
                    </Button>
                </WrapPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding SettingsDirty, Converter={StaticResource Vis}}">
                    <Ellipse Width="8" Height="8" Fill="{DynamicResource Warn}" Margin="0,0,8,0"/>
                    <TextBlock Text="Alterações não salvas"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Background="{DynamicResource ErrSoft}" BorderBrush="{DynamicResource Err}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,12,12"
                        Visibility="{Binding Form.Errors, Converter={StaticResource TextVis}}">
                    <DockPanel>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE783;" Foreground="{DynamicResource Err}" Margin="0,0,10,0" VerticalAlignment="Top"/>
                        <TextBlock Text="{Binding Form.Errors}"/>
                    </DockPanel>
                </Border>
                <WrapPanel>
                    <!-- Laboratório -->
                    <Border Style="{StaticResource SettingCard}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource CardTitle}"><TextBlock Style="{StaticResource Icon}" Text="&#xE7F4;" Foreground="{DynamicResource Accent}" Margin="0,0,10,0"/><TextBlock Style="{StaticResource H3}" Text="Laboratório"/></StackPanel>
                            <TextBlock Style="{StaticResource Label}" Text="Nome do laboratório (sala no Veyon)"/>
                            <TextBox Text="{Binding Form.LabName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Nome do laboratório"/>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,12" Text="Exibido na interface e usado como sala na integração. Mudar o nome deixa os computadores pendentes de integração."/>
                            <TextBlock Style="{StaticResource Label}" Text="Professor (receptor)"/>
                            <TextBlock FontWeight="SemiBold" Text="{Binding Overview.TeacherName}"/>
                            <TextBlock Style="{StaticResource Caption}" Text="Definido na instalação. Certificados e vínculos não mudam por esta tela."/>
                        </StackPanel>
                    </Border>

                    <!-- Comunicação -->
                    <Border Style="{StaticResource SettingCard}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource CardTitle}"><TextBlock Style="{StaticResource Icon}" Text="&#xE839;" Foreground="{DynamicResource Accent}" Margin="0,0,10,0"/><TextBlock Style="{StaticResource H3}" Text="Comunicação"/></StackPanel>
                            <TextBlock Style="{StaticResource Label}" Text="Endereço do professor (nome que os alunos usam; precisa constar no certificado)"/>
                            <TextBox Text="{Binding Form.PublicHost, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Endereço do professor"/>
                            <WrapPanel>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource Label}" Text="Porta"/>
                                    <TextBlock FontWeight="SemiBold" Margin="0,8,0,0" Text="{Binding Form.Port}" ToolTip="Definida na instalação"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Style="{StaticResource Label}" Text="Comunicação recente (s)"/>
                                    <TextBox Width="110" Text="{Binding Form.RecentSeconds, UpdateSourceTrigger=PropertyChanged}" ToolTip="60 a 3600 segundos" AutomationProperties.Name="Segundos para comunicação recente"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Label}" Text="Histórico (dias)"/>
                                    <TextBox Width="110" Text="{Binding Form.RetentionDays, UpdateSourceTrigger=PropertyChanged}" ToolTip="7 a 3650 dias" AutomationProperties.Name="Dias de histórico"/>
                                </StackPanel>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Integração -->
                    <Border Style="{StaticResource SettingCard}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource CardTitle}"><TextBlock Style="{StaticResource Icon}" Text="&#xE895;" Foreground="{DynamicResource Accent}" Margin="0,0,10,0"/><TextBlock Style="{StaticResource H3}" Text="Integração com o Veyon"/></StackPanel>
                            <TextBlock Style="{StaticResource Label}" Text="Padrão de nome amigável dos computadores"/>
                            <ComboBox ItemsSource="{Binding NameChoices}" SelectedItem="{Binding NameChoice}" HorizontalAlignment="Stretch" AutomationProperties.Name="Padrão de nome"/>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,12"><Run Text="Exemplo: "/><Run Text="{Binding Form.NameExample, Mode=OneWay}" Foreground="{DynamicResource Accent}"/><Run Text=". O nome do Windows não é alterado."/></TextBlock>
                            <TextBlock Style="{StaticResource Label}" Text="Endereço gravado no Veyon"/>
                            <ComboBox ItemsSource="{Binding AddressChoices}" SelectedItem="{Binding AddressChoice}" HorizontalAlignment="Stretch" AutomationProperties.Name="Endereço gravado no Veyon"/>
                            <TextBlock Style="{StaticResource Label}" Text="Caminho do veyon-cli.exe (vazio = detectar automaticamente)"/>
                            <TextBox Text="{Binding Form.VeyonCliPath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Caminho do Veyon CLI"/>
                        </StackPanel>
                    </Border>

                    <!-- Repositório de atualizações -->
                    <Border Style="{StaticResource SettingCard}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource CardTitle}"><TextBlock Style="{StaticResource Icon}" Text="&#xE896;" Foreground="{DynamicResource Accent}" Margin="0,0,10,0"/><TextBlock Style="{StaticResource H3}" Text="Atualizações"/></StackPanel>
                            <TextBlock Style="{StaticResource Label}" Text="Repositório público no GitHub (dono/repositorio)"/>
                            <TextBox Text="{Binding Release.Repo, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Repositório do GitHub"/>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,8" Text="Releases públicas: não precisa de token. Usado só por este professor; os alunos recebem daqui."/>
                            <CheckBox IsChecked="{Binding Release.IncludePrerelease}" Content="Incluir versões de teste"/>
                            <CheckBox IsChecked="{Binding Release.AutoCheck}" Content="Buscar automaticamente (só avisa; instalar é sempre manual)"/>
                        </StackPanel>
                    </Border>

                    <!-- Aparência -->
                    <Border Style="{StaticResource SettingCard}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource CardTitle}"><TextBlock Style="{StaticResource Icon}" Text="&#xE790;" Foreground="{DynamicResource Accent}" Margin="0,0,10,0"/><TextBlock Style="{StaticResource H3}" Text="Aparência"/></StackPanel>
                            <CheckBox IsChecked="{Binding Animations}" Content="Animações da interface"/>
                            <TextBlock Style="{StaticResource Caption}" Text="Transições suaves. Também respeitam a opção de efeitos de animação do Windows. Vale para este usuário e é aplicada na hora."/>
                        </StackPanel>
                    </Border>
                </WrapPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
