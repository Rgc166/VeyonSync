<UserControl x:Class="VeyonSync.TeacherApp.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,14,16,24">
            <!-- Cabeçalho -->
            <DockPanel Margin="0,0,0,18">
                <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Top">
                    <Button Command="{Binding CollectAllCmd}" ToolTip="Pede a todos os computadores um envio imediato dos dados atuais">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8B5;" Margin="0,0,8,0"/><TextBlock Text="Solicitar coleta"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding ApplyLocalCmd}" ToolTip="Mostra o resumo e pede confirmação antes de alterar o Veyon">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE895;" Margin="0,0,8,0"/><TextBlock Text="Integrar ao Veyon"/></StackPanel>
                    </Button>
                </WrapPanel>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Style="{StaticResource H1}" Text="Visão geral"/>
                    <TextBlock Style="{StaticResource Muted}">
                        <Run Text="{Binding LabText, Mode=OneWay}"/><Run Text=" · professor "/><Run Text="{Binding Overview.TeacherName, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </DockPanel>

            <!-- Cartões (clicáveis: abrem a lista filtrada) -->
            <UniformGrid Columns="4">
                <Button Style="{StaticResource StatButton}" Command="{Binding OpenMachinesCmd}" CommandParameter="all" AutomationProperties.Name="Computadores cadastrados">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Icon}" Text="&#xE7F8;" Foreground="{DynamicResource Accent}"/>
                            <TextBlock Style="{StaticResource Label}" Text="Cadastrados"/>
                        </DockPanel>
                        <TextBlock Style="{StaticResource Big}" Text="{Binding TotalCount}"/>
                        <TextBlock Style="{StaticResource Caption}" Text="computadores neste laboratório"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource StatButton}" Command="{Binding OpenMachinesCmd}" CommandParameter="recent" AutomationProperties.Name="Com comunicação recente">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Icon}" Text="&#xE73E;" Foreground="{DynamicResource Ok}"/>
                            <TextBlock Style="{StaticResource Label}" Text="Comunicação recente"/>
                        </DockPanel>
                        <TextBlock Style="{StaticResource Big}" Text="{Binding Overview.Recent}"/>
                        <TextBlock Style="{StaticResource Caption}" Text="{Binding Overview.RecentSeconds, StringFormat='nos últimos {0} s'}"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource StatButton}" Command="{Binding OpenMachinesCmd}" CommandParameter="pending" AutomationProperties.Name="Pendentes de integração">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Icon}" Text="{Binding PendingKind, Converter={StaticResource KindGlyph}}" Foreground="{Binding PendingKind, Converter={StaticResource KindBrush}}"/>
                            <TextBlock Style="{StaticResource Label}" Text="Pendentes de integração"/>
                        </DockPanel>
                        <TextBlock Style="{StaticResource Big}" Text="{Binding Overview.VeyonPending}"/>
                        <TextBlock Style="{StaticResource Caption}" Text="aguardando o Veyon"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource StatButton}" Command="{Binding GoCmd}" CommandParameter="5" AutomationProperties.Name="Erros ativos">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Icon}" Text="{Binding ErrorsKind, Converter={StaticResource KindGlyph}}" Foreground="{Binding ErrorsKind, Converter={StaticResource KindBrush}}"/>
                            <TextBlock Style="{StaticResource Label}" Text="Erros ativos"/>
                        </DockPanel>
                        <TextBlock Style="{StaticResource Big}" Text="{Binding Overview.ErrorsPending}"/>
                        <TextBlock Style="{StaticResource Caption}" Text="{Binding ErrorsText}"/>
                    </StackPanel>
                </Button>
            </UniformGrid>

            <!-- Coleta solicitada: resultado real, separado por situação; permanece visível depois do aviso -->
            <Border Style="{StaticResource Card}" Visibility="{Binding HasCollect, Converter={StaticResource Vis}}">
                <StackPanel>
                    <DockPanel>
                        <TextBlock Style="{StaticResource Icon}" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Top"
                                   Text="{Binding CollectKind, Converter={StaticResource KindGlyph}}" Foreground="{Binding CollectKind, Converter={StaticResource KindBrush}}"/>
                        <StackPanel>
                            <TextBlock Style="{StaticResource H3}" Text="{Binding CollectTitle}"/>
                            <TextBlock Style="{StaticResource Caption}" Text="{Binding CollectDetail}"/>
                        </StackPanel>
                    </DockPanel>
                    <ProgressBar Margin="0,12,0,12" Maximum="100" Value="{Binding CollectPercent, Mode=OneWay}" Foreground="{Binding CollectKind, Converter={StaticResource KindBrush}}"/>
                    <WrapPanel>
                        <Border Style="{StaticResource Pill}" Background="{DynamicResource OkSoft}" Margin="0,0,8,6">
                            <TextBlock FontSize="12.5"><Run Text="&#xE73E;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource Ok}"/><Run Text=" Responderam: "/><Run Text="{Binding Collect.Answered, Mode=OneWay}" FontWeight="SemiBold"/></TextBlock>
                        </Border>
                        <Border Style="{StaticResource Pill}" Background="{DynamicResource AccentSoft}" Margin="0,0,8,6">
                            <TextBlock FontSize="12.5"><Run Text="&#xE916;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource Accent}"/><Run Text=" Aguardando: "/><Run Text="{Binding Collect.Waiting, Mode=OneWay}" FontWeight="SemiBold"/></TextBlock>
                        </Border>
                        <Border Style="{StaticResource Pill}" Background="{DynamicResource WarnSoft}" Margin="0,0,8,6">
                            <TextBlock FontSize="12.5"><Run Text="M" FontWeight="Bold" Foreground="{DynamicResource Warn}"/><Run Text=" Modo manual: "/><Run Text="{Binding Collect.Manual, Mode=OneWay}" FontWeight="SemiBold"/></TextBlock>
                        </Border>
                        <Button Style="{StaticResource GhostButton}" Command="{Binding OpenMachinesCmd}" CommandParameter="noanswer" Padding="8,2" MinHeight="26" Margin="0,0,8,6"
                                ToolTip="Ver quem não respondeu">
                            <TextBlock FontSize="12.5"><Run Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource Warn}"/><Run Text=" Sem resposta no prazo: "/><Run Text="{Binding Collect.NoResponse, Mode=OneWay}" FontWeight="SemiBold"/></TextBlock>
                        </Button>
                    </WrapPanel>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                               Text="Só conta como resposta o envio feito por causa deste pedido; sinais de presença comuns não contam. Computadores em modo manual respondem quando alguém clicar em enviar no próprio PC."/>
                </StackPanel>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!-- Resumo do mapa -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Abrir mapa" Command="{Binding GoCmd}" CommandParameter="2" Margin="0"/>
                            <TextBlock Style="{StaticResource H2}" Text="Mapa da sala" Margin="0"/>
                        </DockPanel>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Visibility="{Binding HasMap, Converter={StaticResource Vis}}">
                            <ItemsControl ItemsSource="{Binding MiniMap}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,14,0">
                                            <TextBlock Style="{StaticResource Caption}" Text="{Binding Name}" TextWrapping="NoWrap" Margin="0,0,0,6"/>
                                            <ItemsControl ItemsSource="{Binding Cells}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Width="18" Height="18" CornerRadius="4" Margin="0,0,0,5" ToolTip="{Binding Tip}" BorderThickness="1">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="{Binding Kind, Converter={StaticResource KindBrush}}"/>
                                                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Empty}" Value="True">
                                                                            <Setter Property="Background" Value="Transparent"/>
                                                                            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <WrapPanel Margin="0,8,0,0" Visibility="{Binding HasMap, Converter={StaticResource Vis}}">
                            <StackPanel Orientation="Horizontal" Margin="0,0,14,0"><Border Width="12" Height="12" CornerRadius="3" Background="{DynamicResource Ok}" Margin="0,0,6,0"/><TextBlock Style="{StaticResource Caption}" Text="Comunicação recente"/></StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,14,0"><Border Width="12" Height="12" CornerRadius="3" Background="{DynamicResource TextMuted}" Margin="0,0,6,0"/><TextBlock Style="{StaticResource Caption}" Text="Sem comunicação recente"/></StackPanel>
                            <StackPanel Orientation="Horizontal"><Border Width="12" Height="12" CornerRadius="3" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,6,0"/><TextBlock Style="{StaticResource Caption}" Text="Vazio"/></StackPanel>
                        </WrapPanel>
                        <TextBlock Style="{StaticResource Muted}" Visibility="{Binding HasMap, Converter={StaticResource Vis}, ConverterParameter=invert}"
                                   Text="O mapa ainda não foi montado. Em Mapa da sala, use Editar disposição para criar as fileiras."/>
                    </StackPanel>
                </Border>
                <!-- Atividade recente -->
                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Ver histórico" Command="{Binding GoCmd}" CommandParameter="4" Margin="0"/>
                            <TextBlock Style="{StaticResource H2}" Text="Atividade recente" Margin="0"/>
                        </DockPanel>
                        <TextBlock Style="{StaticResource Muted}" Text="Nenhum evento registrado ainda." Visibility="{Binding HasRecentEvents, Converter={StaticResource Vis}, ConverterParameter=invert}"/>
                        <ItemsControl ItemsSource="{Binding RecentEvents}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,0,0,10">
                                        <TextBlock Style="{StaticResource Icon}" FontSize="14" Margin="0,2,10,0" VerticalAlignment="Top"
                                                   Text="{Binding Result, Converter={StaticResource Glyph}}" Foreground="{Binding Result, Converter={StaticResource Glyph}, ConverterParameter=brush}"/>
                                        <StackPanel>
                                            <TextBlock TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                                                <Run Text="{Binding Kind, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="  "/><Run Text="{Binding Machine, Mode=OneWay}" Foreground="{DynamicResource TextMuted}"/>
                                            </TextBlock>
                                            <TextBlock Style="{StaticResource Caption}" Text="{Binding Detail}" MaxHeight="36" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Style="{StaticResource Caption}" Text="{Binding Ts, Converter={StaticResource Time}}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0">
                <Run Text="Endereço deste professor: "/><Run Text="{Binding Overview.Url, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding CliText, Mode=OneWay}"/>
                <Run Text=" · Sem comunicação não significa que o computador esteja desligado."/>
            </TextBlock>
        </StackPanel>
    </ScrollViewer>
</UserControl>
