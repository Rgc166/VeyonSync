<UserControl x:Class="VeyonSync.TeacherApp.Views.ErrorsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="28,14,16,16">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <Border DockPanel.Dock="Right" Style="{StaticResource Pill}" Padding="12,6" VerticalAlignment="Top" Margin="0,0,12,0"
                    Background="{Binding ActiveErrorsKind, Converter={StaticResource KindSoft}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0" Text="{Binding ActiveErrorsKind, Converter={StaticResource KindGlyph}}" Foreground="{Binding ActiveErrorsKind, Converter={StaticResource KindBrush}}"/>
                    <TextBlock Text="{Binding ActiveErrorsText}" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
            <StackPanel Margin="0,0,16,0">
                <TextBlock Style="{StaticResource H1}" Text="Erros"/>
                <TextBlock Style="{StaticResource Muted}" Text="Acompanhe e resolva problemas de integração e de comunicação. Erros iguais são agrupados."/>
            </StackPanel>
        </DockPanel>

        <WrapPanel DockPanel.Dock="Top">
            <Border Style="{StaticResource SegmentHost}">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource Segment}" GroupName="ErrMode" IsChecked="{Binding ShowActive}" Content="Ativos"/>
                    <RadioButton Style="{StaticResource Segment}" GroupName="ErrMode" IsChecked="{Binding ShowResolved}" Content="Resolvidos"/>
                </StackPanel>
            </Border>
            <ComboBox Width="240" ItemsSource="{Binding MachineChoices}" SelectedItem="{Binding ErrMachine}" AutomationProperties.Name="Filtrar por computador"/>
            <Button Style="{StaticResource GhostButton}" Command="{Binding ExportErrorsCmd}" ToolTip="Exporta a lista exibida (TXT, PDF ou DOCX)">
                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="13" Margin="0,0,6,0"/><TextBlock Text="Exportar lista"/></StackPanel>
            </Button>
        </WrapPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="260"/>
                <ColumnDefinition Width="1.3*"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="8">
                <Grid>
                    <TextBlock Style="{StaticResource Muted}" Margin="10" Text="Nada por aqui. Nenhum erro nesta lista."
                               Visibility="{Binding Errors.Count, Converter={StaticResource CountVis}, ConverterParameter=invert}"/>
                    <ListBox Style="{StaticResource PlainList}" ItemContainerStyle="{StaticResource PlainItem}" ItemsSource="{Binding Errors}" SelectedItem="{Binding SelectedError}"
                             AutomationProperties.Name="Lista de erros">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}" Text="{Binding LastTs, Converter={StaticResource Time}}" Margin="8,0,0,0" TextWrapping="NoWrap"/>
                                    <TextBlock FontSize="14" Margin="0,2,10,0" VerticalAlignment="Top">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                                <Setter Property="Foreground" Value="{DynamicResource Err}"/>
                                                <Setter Property="Text" Value="&#xE783;"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Resolved}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource Ok}"/>
                                                        <Setter Property="Text" Value="&#xE73E;"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold" Text="{Binding Machine, Converter={StaticResource Dash}}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Style="{StaticResource Caption}" Text="{Binding Message}" MaxHeight="34" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}">
                <Grid>
                    <TextBlock Style="{StaticResource Muted}" Text="Selecione um erro para ver os detalhes." Visibility="{Binding HasSelectedError, Converter={StaticResource Vis}, ConverterParameter=invert}"/>
                    <DockPanel Visibility="{Binding HasSelectedError, Converter={StaticResource Vis}}">
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Style="{StaticResource Label}" Text="DETALHES DO ERRO"/>
                            <TextBlock Style="{StaticResource H2}" FontSize="18" Text="{Binding ErrorTitle}"/>
                            <TextBlock Margin="0,0,0,10" Text="{Binding ErrorExplain}"/>
                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,0,12,10"><TextBlock Style="{StaticResource Label}" Text="Computador"/><TextBlock Text="{Binding SelectedError.Machine, Converter={StaticResource Dash}}"/></StackPanel>
                                <StackPanel Margin="0,0,12,10"><TextBlock Style="{StaticResource Label}" Text="Situação"/>
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Ativo"/>
                                                <Setter Property="Foreground" Value="{DynamicResource Err}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedError.Resolved}" Value="True">
                                                        <Setter Property="Text" Value="Resolvido"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource Ok}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </UniformGrid>
                            <TextBlock Style="{StaticResource Label}" Text="Data e hora"/>
                            <TextBlock Text="{Binding ErrorWhen}" Margin="0,0,0,10"/>
                            <TextBlock Style="{StaticResource Label}" Text="Detalhes técnicos"/>
                        </StackPanel>
                        <WrapPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                            <Button Command="{Binding CopyErrorCmd}">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;" FontSize="13" Margin="0,0,6,0"/><TextBlock Text="Copiar detalhes"/></StackPanel>
                            </Button>
                            <Button Command="{Binding ExportErrorCmd}" ToolTip="TXT, PDF ou DOCX (não precisa do Word)">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="13" Margin="0,0,6,0"/><TextBlock Text="Exportar"/></StackPanel>
                            </Button>
                            <Button Command="{Binding ResolveErrorCmd}" CommandParameter="{Binding SelectedError}"
                                    Visibility="{Binding ShowActive, Converter={StaticResource Vis}}">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="13" Margin="0,0,6,0"/><TextBlock Text="Marcar como resolvido"/></StackPanel>
                            </Button>
                            <Button Style="{StaticResource PrimaryButton}" Command="{Binding RetryErrorCmd}" Visibility="{Binding CanRetryError, Converter={StaticResource Vis}}"
                                    ToolTip="Repete a integração com o Veyon somente do que falhou">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="13" Margin="0,0,6,0"/><TextBlock Text="Tentar novamente"/></StackPanel>
                            </Button>
                        </WrapPanel>
                        <Border Style="{StaticResource Inset}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBox Style="{StaticResource ReadOnlyValue}" FontFamily="Consolas" FontSize="12.5" Text="{Binding SelectedError.Message, Mode=OneWay}"/>
                            </ScrollViewer>
                        </Border>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
