<UserControl x:Class="VeyonSync.TeacherApp.Views.UpdatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="clr-namespace:VeyonSync.Desktop;assembly=VeyonSync.Desktop">
    <DockPanel Margin="28,14,16,16">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Style="{StaticResource H1}" Text="Atualizações"/>
            <TextBlock Style="{StaticResource Muted}" Text="O professor baixa do GitHub e distribui aos alunos. Os alunos não acessam o GitHub."/>
        </StackPanel>
        <TabControl>
            <!-- 1. Este professor -->
            <TabItem Header="Este professor">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <d:ReleaseView DataContext="{Binding Release}"/>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,0,12,0"
                                   Text="Ordem recomendada: atualize primeiro este professor e depois os alunos. O repositório e a busca automática ficam em Configurações → Atualizações."/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 2. Distribuição aos alunos -->
            <TabItem Header="Computadores do laboratório">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Pacote -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="1. Pacote do aluno (STD)"/>
                                <WrapPanel>
                                    <Button Command="{Binding DownloadStdCmd}" ToolTip="Baixa o pacote do aluno da versão mais recente publicada e confere a assinatura">
                                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE896;" Margin="0,0,8,0"/><TextBlock Text="Baixar do GitHub"/></StackPanel>
                                    </Button>
                                    <Button Command="{Binding PickPackageCmd}">
                                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8E5;" Margin="0,0,8,0"/><TextBlock Text="Selecionar arquivo"/></StackPanel>
                                    </Button>
                                </WrapPanel>
                                <TextBlock Text="{Binding DownloadStage}" Visibility="{Binding DownloadStage, Converter={StaticResource TextVis}}" Margin="0,0,0,6"/>
                                <ProgressBar Margin="0,0,0,8" Maximum="100" Value="{Binding Release.ProgressPercent, Mode=OneWay}" Visibility="{Binding Release.Busy, Converter={StaticResource Vis}}"/>
                                <Border Style="{StaticResource Inset}" Visibility="{Binding HasPackage, Converter={StaticResource Vis}}">
                                    <DockPanel>
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7B8;" Foreground="{DynamicResource Accent}" Margin="0,0,10,0" VerticalAlignment="Top"/>
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold" Text="{Binding PackageInfoText}"/>
                                            <TextBox Style="{StaticResource ReadOnlyValue}" FontSize="12" Foreground="{DynamicResource TextMuted}" Text="{Binding PackagePath, Mode=OneWay}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0"
                                           Text="Aceita o .vsupd, o ZIP VeyonSync-STD-Update ou o STD-x.y.z.zip do pendrive. O serviço confere edição (só STD), versão, compatibilidade e a assinatura do publicador; depois assina a distribuição com a chave deste professor, que os alunos conferem. O SHA-256 confere a integridade, mas sozinho não comprova a origem."/>
                            </StackPanel>
                        </Border>

                        <!-- Destinos -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <WrapPanel DockPanel.Dock="Right">
                                        <Button Style="{StaticResource GhostButton}" Content="Marcar desatualizados" Command="{Binding SelectOutdatedCmd}"/>
                                        <Button Style="{StaticResource GhostButton}" Content="Marcar / desmarcar todos" Command="{Binding SelectAllTargetsCmd}"/>
                                    </WrapPanel>
                                    <TextBlock Style="{StaticResource H2}" Text="2. Destinos" Margin="0"/>
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding UpdateTargets}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="250" Margin="0,0,8,8" Padding="10,6" CornerRadius="8" Background="{DynamicResource Surface2}">
                                                <CheckBox Style="{StaticResource PlainCheck}" IsChecked="{Binding Selected}" Margin="0">
                                                    <StackPanel>
                                                        <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                                                            <Run Text="{Binding Row.Position, Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding Row.WindowsName, Mode=OneWay}" FontWeight="Normal" Foreground="{DynamicResource TextMuted}"/>
                                                        </TextBlock>
                                                        <TextBlock Style="{StaticResource Caption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis">
                                                            <Run Text="versão "/><Run Text="{Binding VersionText, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Row.AgentState, Mode=OneWay}"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </CheckBox>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Border Style="{StaticResource Inset}" Margin="0,8,0,0">
                                    <WrapPanel>
                                        <TextBlock Text="Começar por um PC de teste:" VerticalAlignment="Center" Margin="0,0,10,8"/>
                                        <ComboBox Width="240" ItemsSource="{Binding UpdateTargets}" SelectedItem="{Binding TestTarget}" AutomationProperties.Name="PC de teste">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock TextWrapping="NoWrap"><Run Text="{Binding Row.Position, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Row.WindowsName, Mode=OneWay}"/></TextBlock>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <Button Command="{Binding PublishTestCmd}">
                                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE9D9;" Margin="0,0,8,0"/><TextBlock Text="Enviar só para o teste"/></StackPanel>
                                        </Button>
                                    </WrapPanel>
                                </Border>
                                <Button Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,12,0,0" Command="{Binding PublishCmd}">
                                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE898;" Margin="0,0,8,0"/><TextBlock Text="Distribuir para os selecionados"/></StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Progresso -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <WrapPanel DockPanel.Dock="Right">
                                        <Button Style="{StaticResource GhostButton}" Command="{Binding RefreshCmd}" Content="Atualizar"/>
                                        <Button Command="{Binding RetryUpdateCmd}" CommandParameter="{Binding SelectedUpdate}">
                                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" Margin="0,0,8,0"/><TextBlock Text="Repetir apenas falhas"/></StackPanel>
                                        </Button>
                                    </WrapPanel>
                                    <TextBlock Style="{StaticResource H2}" Text="3. Andamento da distribuição" Margin="0"/>
                                </DockPanel>
                                <TextBlock Style="{StaticResource Muted}" Text="Nenhuma distribuição ainda." Visibility="{Binding UpdatesList.Count, Converter={StaticResource CountVis}, ConverterParameter=invert}"/>
                                <DataGrid ItemsSource="{Binding UpdatesList}" SelectedItem="{Binding SelectedUpdate}" SelectionMode="Single" MaxHeight="170" Margin="0,0,0,10" Background="Transparent"
                                          Visibility="{Binding UpdatesList.Count, Converter={StaticResource CountVis}}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Versão" Binding="{Binding Version}" Width="90"/>
                                        <DataGridTextColumn Header="Criada" Binding="{Binding Created, Converter={StaticResource Time}}" Width="150"/>
                                        <DataGridTextColumn Header="Pendentes" Binding="{Binding Pending}" Width="90"/>
                                        <DataGridTextColumn Header="Transferindo / instalando" Binding="{Binding Downloading}" Width="170"/>
                                        <DataGridTextColumn Header="Confirmadas" Binding="{Binding Done}" Width="100"/>
                                        <DataGridTextColumn Header="Falhas" Binding="{Binding Failed}" Width="70"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Style="{StaticResource Caption}" Text="{Binding UpdateCounts}" Margin="0,0,0,6"/>
                                <DataGrid ItemsSource="{Binding SelectedUpdate.Targets}" MaxHeight="320" Background="Transparent" Visibility="{Binding UpdatesList.Count, Converter={StaticResource CountVis}}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Computador" Binding="{Binding Machine}" Width="200"/>
                                        <DataGridTemplateColumn Header="Situação" Width="230" SortMemberPath="Status">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0" Text="{Binding StatusLabel, Converter={StaticResource Glyph}}" Foreground="{Binding StatusLabel, Converter={StaticResource Glyph}, ConverterParameter=brush}"/>
                                                        <TextBlock Text="{Binding StatusLabel}" TextWrapping="NoWrap"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Atualizado em" Binding="{Binding Updated, Converter={StaticResource Time}}" Width="150"/>
                                        <DataGridTextColumn Header="Detalhe" Binding="{Binding Detail}" Width="*" ElementStyle="{StaticResource WrapCell}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0"
                                           Text="Pendente = aguardando o computador se comunicar · Transferindo = pacote enviado · Instalando = pacote conferido no aluno · Confirmada = o aluno reiniciou na nova versão · Falhou = o aluno voltou para a versão anterior."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
