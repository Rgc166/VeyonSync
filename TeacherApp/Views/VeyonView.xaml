<UserControl x:Class="VeyonSync.TeacherApp.Views.VeyonView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,14,16,24">
            <TextBlock Style="{StaticResource H1}" Text="Integração com o Veyon"/>
            <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,16">
                <Run Text="Sincroniza os computadores deste laboratório com o Veyon deste professor ("/><Run Text="{Binding LabText, Mode=OneWay}"/><Run Text="). Nunca limpa o cadastro inteiro nem duplica computador quando o IP muda."/>
            </TextBlock>

            <!-- Veyon CLI e backup -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.4*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Background="{Binding CliStateKind, Converter={StaticResource KindSoft}}" BorderBrush="{Binding CliStateKind, Converter={StaticResource KindBrush}}">
                    <DockPanel>
                        <TextBlock Style="{StaticResource Icon}" FontSize="22" Margin="0,0,14,0" VerticalAlignment="Top"
                                   Text="{Binding CliStateKind, Converter={StaticResource KindGlyph}}" Foreground="{Binding CliStateKind, Converter={StaticResource KindBrush}}"/>
                        <StackPanel>
                            <TextBlock Style="{StaticResource H3}" Text="{Binding CliTitle}"/>
                            <TextBox Style="{StaticResource ReadOnlyValue}" FontSize="12" Foreground="{DynamicResource TextMuted}" Text="{Binding VeyonStatus, Mode=OneWay}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Command="{Binding BackupCmd}" Margin="8,0,0,0" VerticalAlignment="Center" Content="Fazer backup agora"/>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE81C;" FontSize="20" Margin="0,0,12,0" Foreground="{DynamicResource Accent}"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Label}" Text="Último backup"/>
                            <TextBlock FontWeight="SemiBold" Text="{Binding LastBackupText}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Contagens da prévia -->
            <UniformGrid Columns="4">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel><TextBlock DockPanel.Dock="Right" Style="{StaticResource Icon}" Text="&#xE710;" Foreground="{DynamicResource Accent}"/><TextBlock Style="{StaticResource Label}" Text="Adicionar"/></DockPanel>
                        <TextBlock Style="{StaticResource Big}" Text="{Binding AddCount}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel><TextBlock DockPanel.Dock="Right" Style="{StaticResource Icon}" Text="&#xE72C;" Foreground="{DynamicResource Ok}"/><TextBlock Style="{StaticResource Label}" Text="Atualizar"/></DockPanel>
                        <TextBlock Style="{StaticResource Big}" Text="{Binding UpdateCount}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel><TextBlock DockPanel.Dock="Right" Style="{StaticResource Icon}" Text="&#xE73E;" Foreground="{DynamicResource TextMuted}"/><TextBlock Style="{StaticResource Label}" Text="Sem alterações"/></DockPanel>
                        <TextBlock Style="{StaticResource Big}" Text="{Binding SameCount}"/>
                    </StackPanel>
                </Border>
                <Border>
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Card}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasConflicts}" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource Err}"/>
                                    <Setter Property="Background" Value="{DynamicResource ErrSoft}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <DockPanel><TextBlock DockPanel.Dock="Right" Style="{StaticResource Icon}" Text="&#xE7BA;" Foreground="{DynamicResource Err}"/><TextBlock Style="{StaticResource Label}" Text="Conflito"/></DockPanel>
                        <TextBlock Style="{StaticResource Big}" Text="{Binding ConflictCount}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Prévia por computador -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <WrapPanel DockPanel.Dock="Right">
                            <Button Command="{Binding PreviewCmd}">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" Margin="0,0,8,0"/><TextBlock Text="Atualizar prévia"/></StackPanel>
                            </Button>
                            <Button Style="{StaticResource PrimaryButton}" Command="{Binding ApplyLocalCmd}">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" Margin="0,0,8,0"/><TextBlock Text="Integrar itens válidos"/></StackPanel>
                            </Button>
                        </WrapPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource H2}" Text="Prévia das mudanças" Margin="0"/>
                            <TextBlock Style="{StaticResource Caption}" Text="{Binding PreviewSummary}"/>
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,4" Text="Clique em Atualizar prévia para comparar os dados recebidos com o Veyon."
                               Visibility="{Binding PreviewLoaded, Converter={StaticResource Vis}, ConverterParameter=invert}"/>
                    <DataGrid ItemsSource="{Binding Changes}" MaxHeight="420" SelectionMode="Single" Background="Transparent" RowDetailsVisibilityMode="VisibleWhenSelected"
                              Visibility="{Binding PreviewLoaded, Converter={StaticResource Vis}}" AutomationProperties.Name="Prévia das mudanças">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Computador" Binding="{Binding Machine}" Width="150"/>
                            <DataGridTemplateColumn Header="Ação" Width="140" SortMemberPath="Action">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0" Text="{Binding Action, Converter={StaticResource Glyph}}" Foreground="{Binding Action, Converter={StaticResource Glyph}, ConverterParameter=brush}"/>
                                            <TextBlock Text="{Binding Action}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Antes" Width="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,4">
                                            <TextBlock Text="{Binding OldName, Converter={StaticResource Dash}}" TextWrapping="NoWrap"/>
                                            <TextBlock Style="{StaticResource Caption}" Text="{Binding OldHost, Converter={StaticResource Dash}}" TextWrapping="NoWrap"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Depois" Width="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,4">
                                            <TextBlock Text="{Binding NewName}" TextWrapping="NoWrap"/>
                                            <TextBlock Style="{StaticResource Caption}" TextWrapping="NoWrap"><Run Text="{Binding NewHost, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding NewLocation, Mode=OneWay}"/></TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Detalhes" Binding="{Binding Detail}" Width="*" ElementStyle="{StaticResource WrapCell}"/>
                        </DataGrid.Columns>
                        <DataGrid.RowDetailsTemplate>
                            <DataTemplate>
                                <Border Margin="10,0,10,10" Padding="12,10" CornerRadius="8" Background="{DynamicResource ErrSoft}" BorderBrush="{DynamicResource Err}" BorderThickness="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Action}" Value="Conflito"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <DockPanel>
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE783;" Foreground="{DynamicResource Err}" Margin="0,0,10,0" VerticalAlignment="Top"/>
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource Err}" Text="Conflito detectado"/>
                                            <TextBlock Text="{Binding Detail}"/>
                                            <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" Text="Este computador fica de fora até o conflito ser resolvido (por exemplo, renomeando o registro no Veyon ou corrigindo o número do PC)."/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </DataGrid.RowDetailsTemplate>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- Resultado da última integração -->
            <Border Style="{StaticResource Card}" Visibility="{Binding HasBatch, Converter={StaticResource Vis}}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Command="{Binding RetryFailedCmd}" Visibility="{Binding BatchHasFailures, Converter={StaticResource Vis}}">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" Margin="0,0,8,0"/><TextBlock Text="Repetir apenas falhas"/></StackPanel>
                        </Button>
                        <TextBlock Style="{StaticResource Icon}" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Top"
                                   Text="{Binding BatchKind, Converter={StaticResource KindGlyph}}" Foreground="{Binding BatchKind, Converter={StaticResource KindBrush}}"/>
                        <StackPanel>
                            <TextBlock Style="{StaticResource H2}" Text="Resultado da última integração" Margin="0"/>
                            <TextBlock Style="{StaticResource Caption}" Text="{Binding BatchSummaryText}"/>
                        </StackPanel>
                    </DockPanel>
                    <DataGrid ItemsSource="{Binding BatchItems}" MaxHeight="300" Background="Transparent">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Computador" Binding="{Binding Machine}" Width="200"/>
                            <DataGridTemplateColumn Header="Resultado" Width="140" SortMemberPath="Outcome">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0" Text="{Binding Outcome, Converter={StaticResource Glyph}}" Foreground="{Binding Outcome, Converter={StaticResource Glyph}, ConverterParameter=brush}"/>
                                            <TextBlock Text="{Binding Outcome}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Detalhe" Binding="{Binding Detail}" Width="*" ElementStyle="{StaticResource WrapCell}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- Outros laboratórios (integração em lote) -->
            <Expander Header="Outros laboratórios autorizados (integração em lote)">
                <StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,10"
                               Text="Cada laboratório tem professor e Veyon próprios. O lote é enviado ao professor responsável, que aplica no Veyon dele com backup. Um professor indisponível não impede os demais."/>
                    <CheckBox Style="{StaticResource PlainCheck}" IsChecked="{Binding IncludeLocal}">
                        <TextBlock><Run Text="Este professor — "/><Run Text="{Binding LabText, Mode=OneWay}"/></TextBlock>
                    </CheckBox>
                    <ItemsControl ItemsSource="{Binding Peers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,0,0,4">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Remover" Margin="8,0,0,0"
                                            Command="{Binding DataContext.RemovePeerCmd, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                    <CheckBox Style="{StaticResource PlainCheck}" IsChecked="{Binding Selected}">
                                        <TextBlock><Run Text="Laboratório "/><Run Text="{Binding Row.Lab, Mode=OneWay}"/><Run Text=" — "/><Run Text="{Binding Row.Name, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Row.LastStatus, Mode=OneWay}" Foreground="{DynamicResource TextMuted}"/></TextBlock>
                                    </CheckBox>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <WrapPanel Margin="0,8,0,0">
                        <Button Command="{Binding AddPeerCmd}"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE710;" Margin="0,0,8,0"/><TextBlock Text="Adicionar professor"/></StackPanel></Button>
                        <Button Command="{Binding BatchPreviewCmd}"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE890;" Margin="0,0,8,0"/><TextBlock Text="Prévia dos selecionados"/></StackPanel></Button>
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding BatchApplyCmd}"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE895;" Margin="0,0,8,0"/><TextBlock Text="Integrar selecionados"/></StackPanel></Button>
                        <Button Command="{Binding BatchRetryCmd}"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" Margin="0,0,8,0"/><TextBlock Text="Repetir só falhas"/></StackPanel></Button>
                    </WrapPanel>
                </StackPanel>
            </Expander>

            <!-- Backups -->
            <Expander Header="Backups da configuração do Veyon (este laboratório)">
                <StackPanel>
                    <DataGrid x:Name="BackupGrid" ItemsSource="{Binding Backups}" MaxHeight="240" SelectionMode="Single" Background="Transparent">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Quando" Binding="{Binding Ts, Converter={StaticResource Time}}" Width="150"/>
                            <DataGridTextColumn Header="Arquivo" Binding="{Binding File}" Width="*"/>
                            <DataGridTextColumn Header="Motivo" Binding="{Binding Note}" Width="260" ElementStyle="{StaticResource WrapCell}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Button Style="{StaticResource DangerButton}" HorizontalAlignment="Left" Margin="0,10,0,0" Command="{Binding RestoreCmd}" CommandParameter="{Binding SelectedItem, ElementName=BackupGrid}">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE777;" Margin="0,0,8,0"/><TextBlock Text="Restaurar backup selecionado"/></StackPanel>
                    </Button>
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
