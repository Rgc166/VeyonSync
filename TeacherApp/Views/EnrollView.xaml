<UserControl x:Class="VeyonSync.TeacherApp.Views.EnrollView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,14,16,24">
            <TextBlock Style="{StaticResource H1}" Text="Credenciamento"/>
            <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,8" Text="Conectar novos computadores a este professor."/>
            <!-- Arquivo e código se complementam -->
            <Border Style="{StaticResource Inset}" Margin="0,0,12,16">
                <DockPanel>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" Foreground="{DynamicResource Accent}" Margin="0,0,10,0" VerticalAlignment="Top"/>
                    <TextBlock Text="O arquivo de ligação e o código se complementam: o arquivo preenche o professor e o laboratório no aluno; o código temporário autoriza o credenciamento. Use os dois em cada computador."/>
                </DockPanel>
            </Border>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 1. Arquivo de ligação -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Width="36" Height="36" CornerRadius="9" Background="{DynamicResource PrimarySoft}" Margin="0,0,12,0">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE71B;" HorizontalAlignment="Center" Foreground="{DynamicResource Accent}"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource H3}" Text="1. Arquivo de ligação do laboratório"/>
                                <TextBlock Style="{StaticResource Caption}" Text="O mesmo arquivo serve para todos os alunos deste laboratório."/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Label}" Text="Laboratório"/>
                        <TextBlock FontWeight="SemiBold" Margin="0,0,0,10"><Run Text="{Binding Link.LabName, Mode=OneWay}"/><Run Text=" ("/><Run Text="{Binding Link.Lab, Mode=OneWay}"/><Run Text=")"/></TextBlock>
                        <TextBlock Style="{StaticResource Label}" Text="Endereço do professor"/>
                        <Border Style="{StaticResource Inset}" Margin="0,0,0,10" Padding="10,4">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Command="{Binding CopyUrlCmd}" ToolTip="Copiar endereço" AutomationProperties.Name="Copiar endereço">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;" FontSize="13"/>
                                </Button>
                                <TextBox Style="{StaticResource ReadOnlyValue}" VerticalAlignment="Center" Foreground="{DynamicResource Accent}" Text="{Binding Link.Url, Mode=OneWay}"/>
                            </DockPanel>
                        </Border>
                        <Border Background="{DynamicResource WarnSoft}" BorderBrush="{DynamicResource Warn}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,10"
                                Visibility="{Binding HasLinkWarnings, Converter={StaticResource Vis}}">
                            <DockPanel>
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" Foreground="{DynamicResource Warn}" Margin="0,0,8,0" VerticalAlignment="Top"/>
                                <TextBlock Text="{Binding LinkWarnings}"/>
                            </DockPanel>
                        </Border>
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding ExportLinkCmd}" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE896;" Margin="0,0,8,0"/><TextBlock Text="Exportar arquivo de ligação"/></StackPanel>
                        </Button>
                        <Expander Header="Certificado (conferência)" Margin="0,8,0,8" Background="Transparent">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Label}" Text="Nomes válidos"/>
                                <TextBox Style="{StaticResource ReadOnlyValue}" Text="{Binding CertNamesText, Mode=OneWay}" Margin="0,0,0,8"/>
                                <TextBlock Style="{StaticResource Label}" Text="Validade"/>
                                <TextBlock Text="{Binding Link.CertNotAfter, Converter={StaticResource Time}}" Margin="0,0,0,8"/>
                                <TextBlock Style="{StaticResource Label}" Text="Impressão digital SHA-256"/>
                                <TextBox Style="{StaticResource ReadOnlyValue}" FontFamily="Consolas" FontSize="12" Text="{Binding Link.CertSha256, Mode=OneWay}"/>
                            </StackPanel>
                        </Expander>
                        <TextBlock Style="{StaticResource Caption}"
                                   Text="Contém só dados públicos (endereço, laboratório, certificado público e chave pública de atualização). Não contém senhas, chaves privadas, tokens nem códigos."/>
                    </StackPanel>
                </Border>

                <!-- 2. Código temporário -->
                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Width="36" Height="36" CornerRadius="9" Background="{DynamicResource PrimarySoft}" Margin="0,0,12,0">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8D7;" HorizontalAlignment="Center" Foreground="{DynamicResource Accent}"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource H3}" Text="2. Código temporário de credenciamento"/>
                                <TextBlock Style="{StaticResource Caption}" Text="Autoriza um computador por vez."/>
                            </StackPanel>
                        </StackPanel>
                        <Border Style="{StaticResource Inset}" Padding="16,10" Margin="0,0,0,10">
                            <Grid>
                                <TextBlock Text="Nenhum código ativo" Foreground="{DynamicResource TextMuted}" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,12"
                                           Visibility="{Binding HasCode, Converter={StaticResource Vis}, ConverterParameter=invert}"/>
                                <DockPanel Visibility="{Binding HasCode, Converter={StaticResource Vis}}">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Command="{Binding CopyCodeCmd}" ToolTip="Copiar código" AutomationProperties.Name="Copiar código" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;" FontSize="16"/>
                                    </Button>
                                    <TextBox Style="{StaticResource ReadOnlyValue}" FontSize="40" FontFamily="Consolas" FontWeight="SemiBold" HorizontalAlignment="Center" TextWrapping="NoWrap"
                                             Text="{Binding CodeDisplay, Mode=OneWay}" AutomationProperties.Name="Código de credenciamento"/>
                                </DockPanel>
                            </Grid>
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12" Visibility="{Binding HasCode, Converter={StaticResource Vis}}">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE916;" FontSize="13" Foreground="{DynamicResource TextMuted}" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding CodeInfo}"/>
                        </StackPanel>
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding NewCodeCmd}" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8D7;" Margin="0,0,8,0"/><TextBlock Text="Gerar código"/></StackPanel>
                        </Button>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0"
                                   Text="Uso único, válido por 15 minutos, com limite de tentativas. Gerar outro invalida o anterior. O mesmo tipo de código autoriza outro professor a pedir integrações em lote (Integração → Outros laboratórios)."/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
