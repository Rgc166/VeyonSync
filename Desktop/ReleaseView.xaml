<UserControl x:Class="VeyonSync.Desktop.ReleaseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Atualização do próprio computador. No STD, os controles do GitHub ficam ocultos (o aluno não acessa o GitHub). -->
    <StackPanel>
        <Border Style="{StaticResource Card}" Background="{DynamicResource WarnSoft}" BorderBrush="{DynamicResource Warn}" Visibility="{Binding KeyMissing, Converter={StaticResource Vis}}">
            <DockPanel>
                <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" Foreground="{DynamicResource Warn}" Margin="0,0,10,0" VerticalAlignment="Top"/>
                <TextBlock Text="Esta versão foi compilada sem a chave do publicador e não consegue conferir pacotes assinados. Atualize uma vez pelo pendrive (INICIAR.bat → Aplicar atualização)."/>
            </DockPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource H2}" Text="{Binding ProductText}"/>
                <WrapPanel Margin="0,4,0,8">
                    <StackPanel Margin="0,0,28,8">
                        <TextBlock Style="{StaticResource Label}" Text="Instalada"/>
                        <TextBlock Style="{StaticResource Big}" Text="{Binding InstalledText}"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE76C;" FontSize="18" Foreground="{DynamicResource TextMuted}" Margin="0,14,28,8"
                               Visibility="{Binding HasAvailable, Converter={StaticResource Vis}}"/>
                    <StackPanel Margin="0,0,16,8" Visibility="{Binding HasAvailable, Converter={StaticResource Vis}}">
                        <TextBlock Style="{StaticResource Label}" Text="Disponível"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Big}" Foreground="{DynamicResource Accent}" Text="{Binding AvailableText}"/>
                            <Border Style="{StaticResource Pill}" Background="{DynamicResource OkSoft}" Margin="10,0,0,0">
                                <TextBlock Text="{Binding AvailableTag}" FontSize="12" Foreground="{DynamicResource Ok}"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </WrapPanel>
                <TextBlock Style="{StaticResource Caption}" Text="{Binding RepoText}" Visibility="{Binding IsThc, Converter={StaticResource Vis}}"/>
                <TextBlock Style="{StaticResource Caption}" Text="{Binding LastCheckText}" Margin="0,2,0,0" Visibility="{Binding IsThc, Converter={StaticResource Vis}}"/>

                <StackPanel Visibility="{Binding HasAvailable, Converter={StaticResource Vis}}" Margin="0,12,0,0">
                    <TextBlock Style="{StaticResource H3}" Text="{Binding NotesTitle}" Margin="0,0,0,6"/>
                    <Border Style="{StaticResource Inset}" MaxHeight="200">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBox Style="{StaticResource ReadOnlyValue}" Text="{Binding NotesText, Mode=OneWay}"/>
                        </ScrollViewer>
                    </Border>
                </StackPanel>

                <WrapPanel Margin="0,16,0,0">
                    <Button Command="{Binding CheckCmd}" Visibility="{Binding IsThc, Converter={StaticResource Vis}}">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE721;" Margin="0,0,8,0"/><TextBlock Text="Buscar no GitHub"/></StackPanel>
                    </Button>
                    <Button Command="{Binding FileCmd}">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8E5;" Margin="0,0,8,0"/><TextBlock Text="Atualizar por arquivo"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding InstallCmd}" Visibility="{Binding IsThc, Converter={StaticResource Vis}}">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE896;" Margin="0,0,8,0"/><TextBlock Text="Baixar e instalar"/></StackPanel>
                    </Button>
                </WrapPanel>
                <TextBlock Style="{StaticResource Caption}" Visibility="{Binding IsStd, Converter={StaticResource Vis}}" Margin="0,0,0,4"
                           Text="Aceita o arquivo .vsupd ou o ZIP VeyonSync-STD-Update. O pacote do professor (THC) é recusado aqui."/>
                <TextBlock Style="{StaticResource Caption}" Visibility="{Binding IsThc, Converter={StaticResource Vis}}" Margin="0,0,0,4"
                           Text="Por arquivo: aceita o .vsupd ou o ZIP VeyonSync-THC-Update. O pacote do aluno (STD) é recusado aqui."/>

                <StackPanel Visibility="{Binding Busy, Converter={StaticResource Vis}}" Margin="0,8,0,0">
                    <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100"/>
                    <TextBlock Text="{Binding StageText}" Margin="0,6,0,0"/>
                </StackPanel>
                <DockPanel Margin="0,8,0,0" Visibility="{Binding Message, Converter={StaticResource TextVis}}">
                    <TextBlock Style="{StaticResource Icon}" Margin="0,0,8,0" VerticalAlignment="Top"
                               Text="{Binding MessageKind, Converter={StaticResource KindGlyph}}" Foreground="{Binding MessageKind, Converter={StaticResource KindBrush}}"/>
                    <TextBlock Text="{Binding Message}"/>
                </DockPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource H2}" Text="Última atualização deste computador"/>
                <DockPanel>
                    <TextBlock Style="{StaticResource Icon}" Margin="0,0,10,0" VerticalAlignment="Top" Visibility="{Binding HasLastResult, Converter={StaticResource Vis}}"
                               Text="{Binding LastResultKind, Converter={StaticResource KindGlyph}}" Foreground="{Binding LastResultKind, Converter={StaticResource KindBrush}}"/>
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="{Binding LastResultTitle}"/>
                        <TextBlock Style="{StaticResource Caption}" Text="{Binding LastResultText}" Visibility="{Binding HasLastResult, Converter={StaticResource Vis}}"/>
                    </StackPanel>
                </DockPanel>
                <TextBox Style="{StaticResource ReadOnlyValue}" Margin="0,10,0,0" FontSize="12" Foreground="{DynamicResource TextMuted}"
                         Text="{Binding Status.LogFolder, Mode=OneWay, StringFormat='Registros (TXT): {0}'}"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
